# ==============================================================================
# HUMS ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure values for local or production use.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Application Settings
APP_NAME=Hums
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true
LOG_LEVEL=INFO

# Security & Authentication (Generate secure secrets in production using: openssl rand -hex 32)
SECRET_KEY=change-this-insecure-secret-key-for-development-only-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Database (PostgreSQL)
# Note: Defaults to host port 5434 to avoid conflict with standard host PostgreSQL
POSTGRES_PORT=5434
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://hums_user:hums_password@localhost:5434/hums_db
# Synchronous connection for Alembic migrations if needed:
DATABASE_URL_SYNC=postgresql://hums_user:hums_password@localhost:5434/hums_db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO / Cloudflare R2)
# For local development with MinIO:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hums-audio
S3_REGION=us-east-1
S3_SECURE=false

# Media Delivery (CDN URL prefix for audio streaming)
CDN_BASE_URL=http://localhost:9000/hums-audio

# Profile & Avatar Settings
MAX_AVATAR_SIZE_MB=5

# Artificial Intelligence (Gemini API - Reserved for future roadmap features)
GEMINI_API_KEY=

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Push Notifications (Firebase Cloud Messaging / Mock)
PUSH_ENABLED=true
PUSH_PROVIDER=mock
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
