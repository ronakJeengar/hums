# ==============================================================================
# Hums Web Platform — Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Backend FastAPI service URL for server-side requests (BFF auth and SSR)
# Local development on host machine: http://127.0.0.1:8001
# Docker container service-to-service: http://api:8001 or http://hums_api:8001
INTERNAL_API_URL=http://127.0.0.1:8001

# Public API URL (fallback for direct client-side requests if ever needed)
# Local development: http://127.0.0.1:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
